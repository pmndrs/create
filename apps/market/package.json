{
  "name": "market",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenvx run -- next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "dotenvx run -- prisma generate",
    "db:push": "dotenvx run -- prisma db push",
    "db:studio": "dotenvx run -- prisma studio",
    "db:seed": "dotenvx run -- tsx prisma/seed.ts",
    "db:migrate": "dotenvx run -- prisma migrate dev",
    "db:reset": "dotenvx run -- prisma migrate reset",
    "postinstall": "prisma generate && node node_modules/puppeteer/install.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.858.0",
    "@aws-sdk/s3-request-presigner": "^3.858.0",
    "@pmndrs/chef": "workspace:^",
    "@pmndrs/vite-chef": "workspace:^",
    "@pmndrs/vite-esmsh": "workspace:^",
    "@prisma/client": "^6.13.0",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.13",
    "@supabase/supabase-js": "^2.53.0",
    "better-auth": "^1.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.509.0",
    "memfs": "^4.28.0",
    "nanoid": "^5.1.5",
    "next": "15.4.5",
    "prisma": "^6.13.0",
    "puppeteer": "^24.15.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "semver": "^7.7.2",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.38.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/semver": "^7.7.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.2.9",
    "typescript": "^5"
  }
